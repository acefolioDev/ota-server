# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Required before admin dashboard mutations are enabled.
OTA_ADMIN_TOKEN="replace-with-a-long-random-secret"

# Public origin used to construct immutable bundle and asset URLs.
PUBLIC_URL="http://localhost:3000"

# Asset storage directory (must be shared by publishing and the API server).
OTA_STORAGE_DIR="storage"

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

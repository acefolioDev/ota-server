{
  "name": "ota-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "elpod dev",
    "start": "elpod start",
    "build": "bun run typecheck && bun run dashboard:build",
    "elpod": "elpod",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "db:status": "prisma migration status",
    "typecheck": "tsc --noEmit",
    "dashboard:dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dashboard:build": "vite build --config vite.config.ts",
    "publish:update": "bun scripts/publish-update.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "@elpod/core": "^0.1.1",
    "@prisma/orm-postgres": "^8.0.0-rc.22",
    "dotenv": "^18.0.9",
    "elysia": "^1.4.30",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@elpod/cli": "^0.1.0",
    "@preact/preset-vite": "^2.10.6",
    "@prisma/cli-engine": "0.9.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.0",
    "prisma": "^8.0.0-rc.30",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
